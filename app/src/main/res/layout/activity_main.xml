<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="@string/title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- الفيديو -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickVideo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/pick_video"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvVideoName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:ellipsize="middle"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/no_video"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- الترجمة -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickSrt"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/pick_srt"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvSrtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:ellipsize="middle"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/no_srt"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Start -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:enabled="false"
            android:text="@string/start"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- التقدم -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:max="100"
            android:progress="0"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/tvPercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textSize="16sp" />

        <!-- Cancel -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="@string/cancel"
            android:visibility="gone" />

        <!-- فتح الفيديو بعد النجاح -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpen"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="@string/open_video"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
